# Vybe Signalling Server Environment Configuration
PORT=5000
CLIENT_URL=http://localhost:3000

# Supabase Credentials (optional for local dev, required for prod moderation)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Salt for hashing IP addresses to ensure user privacy
IP_HASH_SALT=vybe-custom-production-salt

# Microsoft PhotoDNA API (optional, for CSAM hash matching)
PHOTODNA_API_KEY=your-photodna-key
